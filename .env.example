# Sao chép file này thành .env rồi điền giá trị thật của bạn. Không commit .env lên git.

# ===== Google Gemini =====
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ===== Database (MySQL - dùng chung DB "cinema2" với Backend) =====
# Cách 1: khai báo từng phần
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=cinema2
# Cách 2 (tuỳ chọn): dùng 1 connection string duy nhất, nếu có sẽ ưu tiên hơn các biến DB_* ở trên
# DATABASE_URL=mysql://root:CHANGE_ME@localhost:3306/cinema2

# ===== Frontend =====
# Dùng để sinh link đặt vé trả về cho khách trong chatbot (generate_booking_link)
FRONTEND_URL=http://localhost:3000

# ===== Server =====
PORT=5001
